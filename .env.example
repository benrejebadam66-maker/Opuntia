# Copy this file to ".env" and fill your real keys.
# Never commit ".env".

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT=35
AI_MAX_RETRIES=2
SHOW_AI_STATUS=1
AI_CACHE_TTL_SEC=20
MEMORY_ENABLED=1
FEEDBACK_ENABLED=1
MEMORY_SUMMARY_TRIGGER=14
MEMORY_SUMMARY_KEEP_LAST=6

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_STT_MODEL=whisper-large-v3-turbo
VOICE_LANG_HINTS=en-US
VOICE_RACE_GOOGLE=1
VOICE_SENSITIVITY=high
VOICE_MIN_RMS=6
VOICE_NOISE_MULT=0.7
VOICE_MIN_CHUNK_SEC=0.10
VOICE_TARGET_RMS=4400
VOICE_MAX_AMPLIFY=30.0
VOICE_CALIBRATION_SEC=1.2
VOICE_SAMPLE_RATE=16000
VOICE_CHUNK_SIZE=1024
# Optional: force a specific microphone device index
VOICE_DEVICE_INDEX=

SCREEN_CAPTURE_MAX_W=1920
SCREEN_CAPTURE_MAX_H=1080
SCREEN_CAPTURE_FORMAT=png
SCREEN_CAPTURE_JPEG_QUALITY=88
SCREEN_VISION_DETAIL_MODE=high
SCREEN_VISION_FAST_MODE=1
SCREEN_TASK_MODE=1
SCREEN_TASK_JSON_MODE=1

ALIBABA_MODEL_STUDIO_API_KEY=
DASHSCOPE_API_KEY=

QWEN_MODEL=qwen-plus
QWEN_FALLBACK_MODELS=qwen-turbo
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-pro

OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_BUILTIN_SEARCH=1

# =============================================================================
# WEB SEARCH & BROWSING CONFIGURATION
# =============================================================================

# Search providers (comma-separated): serpapi, google_cse, google_html, ddg, bing_rss
WEB_SEARCH_PROVIDERS=ddg_lite,bing,ddg,bing_rss
WEB_SEARCH_MIN_PAUSE_SEC=1.2
WEB_SEARCH_TIMEOUT_SEC=5
WEB_SEARCH_CACHE_TTL_SEC=45

# Live web research
LIVE_WEB_PREFETCH=0
WEB_RESEARCH_AUTO=1
WEB_RESEARCH_MAX_PASSES=3
WEB_RESEARCH_RESULTS_PER_PASS=5
WEB_RESEARCH_TRACE=0
WEB_UNIVERSAL_MODE=0

# Playwright for JavaScript-heavy sites
WEB_USE_PLAYWRIGHT=0
WEB_RESPECT_ROBOTS=1
WEB_ROBOTS_CACHE_TTL_SEC=1800

# =============================================================================
# ADVANCED SEARCH TOOL TYPES
# =============================================================================
# Enable/disable specific search tool types (comma-separated)
# Options: info, image, news, api, tool, data, research, video, shopping
SEARCH_TOOL_TYPES=info,image,news,api,tool,data,research,video,shopping

# Intelligent routing
AUTO_SEARCH_CONFIDENCE=0.65
SEARCH_MAX_ITERATIONS=5
SEARCH_DEEP_BROWSE=1
SEARCH_CITATION_STYLE=numbered
SEARCH_TRACE_ENABLED=0

# Browser tool configuration (for deep page browsing)
BROWSER_HEADLESS=1
BROWSER_TIMEOUT_MS=15000
BROWSER_WAIT_LOAD_MS=3000
BROWSER_EXTRACT_IMAGES=0
BROWSER_EXTRACT_LINKS=1

# =============================================================================
# SOURCE ATTRIBUTION & CREDIBILITY
# =============================================================================
SOURCE_ATTRIBUTION=1
SOURCE_SHOW_CONFIDENCE=1
SOURCE_MIN_CREDIBILITY=0.3

# Training data vs live search distinction
DISTINGUISH_SOURCE=1
TRAINING_DATA_CUTOFF=2024-01-01

# =============================================================================
# API KEYS FOR SEARCH SERVICES
# =============================================================================
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# =============================================================================
# PRAYER TIMES & WEATHER (Optional)
# =============================================================================
DEFAULT_PRAYER_CITY=Tunis
DEFAULT_PRAYER_COUNTRY=Tunisia
PRAYER_METHOD=3

DEFAULT_WEATHER_CITY=Tunis
WHISPER_LANGUAGE=en
